# ─────────────────────────────────────────────────────────────────────────────
# BGRemover Video MCP Server — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Required for STDIO server (local Claude Desktop, Cursor, CLI tools).
# Not needed for the HTTP server — users send their own key as Bearer token.
BGREMOVER_API_KEY=your_bgremover_api_key

# Optional: API base URL (override for staging/testing)
BGREMOVER_API_BASE_URL=https://www.bgremover.video/api/v1

# Optional: Request timeout in milliseconds (default: 120000)
BGREMOVER_TIMEOUT_MS=120000

# ─── HTTP server settings ─────────────────────────────────────────────────────

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed Host headers for DNS rebinding protection
ALLOWED_HOSTS=mcp.bgremover.video,localhost

# ─── OAuth 2.1 settings (for web Claude / ChatGPT support) ───────────────────
#
# These tell the MCP server how to advertise the bgremover.video OAuth endpoints so
# that web clients can redirect users through the standard authorization-code
# flow (with PKCE).  Set them to your production URLs before deploying.
#
# MCP_SERVER_URL   — public URL of THIS server (used in the OAuth discovery doc)
# BGREMOVER_OAUTH_*   — bgremover.video's OAuth 2.1 authorization server endpoints
#
MCP_SERVER_URL=https://mcp.bgremover.video

BGREMOVER_OAUTH_ISSUER=https://www.bgremover.video
BGREMOVER_OAUTH_AUTHORIZE=https://www.bgremover.video/oauth/authorize
BGREMOVER_OAUTH_TOKEN=https://www.bgremover.video/oauth/token
BGREMOVER_OAUTH_REGISTER=https://www.bgremover.video/oauth/register